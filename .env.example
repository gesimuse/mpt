# --- Required ---
NIM_API_KEY=nvapi-xxxx                 # build.nvidia.com -> free API key, used for vision QA
CIVITAI_API_KEY=xxxx                   # civitai.com/user/account -> read-only, search/gallery only

TIKTOK_CLIENT_KEY=xxxx                 # developers.tiktok.com app
TIKTOK_CLIENT_SECRET=xxxx
TIKTOK_REFRESH_TOKEN_AIBEAUTY=xxxx     # run get_tiktok_token.py, logged into the aibeauty account

PAGES_BASE_URL=https://gesimuse.github.io/mpt  # images are committed to the gh-pages
                                        # branch and served directly from there for
                                        # TikTok's PULL_FROM_URL to fetch (needs a real
                                        # push-capable git remote configured locally --
                                        # `gh auth setup-git` handles that)

# --- Optional ---
NIM_MODEL=meta/llama-3.3-70b-instruct
SUPERVISOR_ENABLED=1                   # set to 0 to skip vision QA (local testing only)
NICHES=                                # e.g. "aibeauty" to limit a run
DRY_RUN=                               # set to 1 to generate + QA without queuing a draft
HF_TOKEN=hf_xxxx                       # huggingface.co -> free -> raises the rate limit on the
                                        # LCM-LoRA download sdgen.py pulls every run
