# --- Required ---
# Ollama serves vision QA (supervisor.py) and is the FALLBACK text backend for
# captions/motion prompts (llm.py tries HF's router first -- see HF_TOKEN below).
# Install ollama, `ollama serve`, then `ollama pull llava:7b` and
# `ollama pull llama3.2:3b`.
# (llama3.2-vision's mllama arch is not supported by current Ollama's llama-server.)
OLLAMA_URL=http://localhost:11434/v1/chat/completions
CIVITAI_API_KEY=xxxx                   # civitai.com/user/account -> read-only, search/gallery only

TIKTOK_CLIENT_KEY=xxxx                 # developers.tiktok.com app
TIKTOK_CLIENT_SECRET=xxxx
TIKTOK_REFRESH_TOKEN_AIBEAUTY=xxxx     # run get_tiktok_token.py, logged into the aibeauty account

PAGES_BASE_URL=https://gesimuse.github.io/mpt  # images are committed to the gh-pages
                                        # branch and served directly from there for
                                        # TikTok's PULL_FROM_URL to fetch (needs a real
                                        # push-capable git remote configured locally --
                                        # `gh auth setup-git` handles that)

# --- Optional ---
SUPERVISOR_VISION_MODELS=llava:7b       # comma-separated ollama vision models; every one must
                                            # agree an image passes, so more = stricter + slower
CAPTION_MODEL=llama3.2:3b                # ollama text model for captions (the FALLBACK
                                        # backend; HF's router is tried first)
CAPTION_HF_MODEL=meta-llama/Llama-3.1-8B-Instruct:fastest
                                        # llm.py's primary caption/motion model on HF's
                                        # router. Must NOT be a reasoning model --
                                        # gpt-oss-20b and Qwen3 both spend the whole
                                        # token budget on a `reasoning` field and return
                                        # content: null (checked live)
OLLAMA_TIMEOUT=240                      # seconds. The old hardcoded 30 is why captions
                                        # silently fell back to the fixed hashtag string
                                        # on nearly every CI run: llama3.2:3b on 2 vCPUs
                                        # cannot answer that fast
SUPERVISOR_ENABLED=1                   # set to 0 to skip vision QA (local testing only)
NICHES=                                # e.g. "aibeauty" to limit a run
DRY_RUN=                               # set to 1 to generate + QA without queuing a draft
HF_TOKEN=hf_xxxx                       # huggingface.co -> free. Three jobs: raises the rate
                                        # limit on the LCM-LoRA download sdgen.py pulls every
                                        # run, attributes ZeroGPU video calls to your account,
                                        # and authenticates llm.py's caption calls to HF's
                                        # router. That last one needs a FINE-GRAINED token with
                                        # "Make calls to Inference Providers" -- a plain read
                                        # token 401s there and llm.py falls back to Ollama
HF_TOKENS=hf_xxxx,hf_yyyy              # optional, one per HF ACCOUNT (not per token -- tokens
                                        # from the same account share one quota pool). videogen
                                        # rotates on a ZeroGPU quota error, llm.py rotates on an
                                        # out-of-credit router error

KAGGLE_USERNAME=xxxx                   # optional. Image generation on Kaggle's own GPU
KAGGLE_API_TOKEN=xxxx                  # (kaggle_imagegen.py) and video generation there as the
                                        # fallback under ZeroGPU (kaggle_videogen.py). Both are
                                        # skipped cleanly when unset
KAGGLE_ACCELERATOR=NvidiaTeslaT4       # optional. The default P100 is sm_60, which Kaggle's own
                                        # preinstalled torch has no kernels for. Verified on a real
                                        # probe kernel: this flag returns TWO T4s (15GB each, sm_75)
                                        # with working fp16

TIKTOK_CC_COOKIE=                      # optional. Cookie header from a logged-in TikTok Creative
                                        # Center tab, which is the only way its trending-hashtag
                                        # endpoint answers (unauthenticated it returns HTTP 200
                                        # with {"code":40101,"msg":"no permission"}). Without it,
                                        # trends.py uses niches.json's own trend_hashtags list

# --- Video niche (aibeautyvideo) ---
# HF_TOKEN/HF_TOKENS above cover this: videogen.py walks a ladder of ZeroGPU Spaces
# (Wan 2.2 I2V rCM, Wan 2.1 fast, LTX-Video distilled), rotating accounts when one
# runs out of its ~5 GPU-minutes/day. KAGGLE_* above adds a self-hosted T4 fallback
# under all of that. Nothing else new to set -- the video niche reuses the aibeauty
# photo cron's images and the same TikTok token (tiktok_token_niche: "aibeauty" in
# niches.json). There is no cron: it is fired by hand from picker.html.
VIDEO_SPACES=                          # optional, comma-separated. Overrides the Space ladder
                                        # order; only ids with an adapter in videogen.SPACES
