# --- Required ---
NIM_API_KEY=nvapi-xxxx                 # build.nvidia.com -> free API key
PEXELS_API_KEY=xxxx                    # pexels.com/api -> free
YT_CLIENT_ID=xxxx.apps.googleusercontent.com
YT_CLIENT_SECRET=xxxx


TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN_CODEAZ=

# One refresh token per niche channel (run get_youtube_token.py once per channel)
YT_REFRESH_TOKEN_SELLERSIGNAL=xxxx
YT_REFRESH_TOKEN_WEALTHLOOP=xxxx
YT_REFRESH_TOKEN_MINDFACTS=xxxx
YT_REFRESH_TOKEN_AIDAILYTOOLS=xxxx

# --- Optional ---
NIM_MODEL=meta/llama-3.3-70b-instruct
UPLOAD_POST_API_KEY=                   # set to enable TikTok (free tier = 10 uploads/mo)
NICHES=                                # e.g. "sellersignal,wealthloop" to limit a run
