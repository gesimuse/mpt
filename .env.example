# --- Required ---
# Ollama serves vision QA (supervisor.py) and captions (caption_writer.py).
# Install ollama, `ollama serve`, then `ollama pull llava:7b`.
# (llama3.2-vision's mllama arch is not supported by current Ollama's llama-server.)
OLLAMA_URL=http://localhost:11434/v1/chat/completions
CIVITAI_API_KEY=xxxx                   # civitai.com/user/account -> read-only, search/gallery only

TIKTOK_CLIENT_KEY=xxxx                 # developers.tiktok.com app
TIKTOK_CLIENT_SECRET=xxxx
TIKTOK_REFRESH_TOKEN_AIBEAUTY=xxxx     # run get_tiktok_token.py, logged into the aibeauty account

PAGES_BASE_URL=https://gesimuse.github.io/mpt  # images are committed to the gh-pages
                                        # branch and served directly from there for
                                        # TikTok's PULL_FROM_URL to fetch (needs a real
                                        # push-capable git remote configured locally --
                                        # `gh auth setup-git` handles that)

# --- Optional ---
SUPERVISOR_VISION_MODELS=llava:7b       # comma-separated ollama vision models; every one must
                                            # agree an image passes, so more = stricter + slower
CAPTION_MODEL=llama3.2:3b                # ollama text model for captions
SUPERVISOR_ENABLED=1                   # set to 0 to skip vision QA (local testing only)
NICHES=                                # e.g. "aibeauty" to limit a run
DRY_RUN=                               # set to 1 to generate + QA without queuing a draft
HF_TOKEN=hf_xxxx                       # huggingface.co -> free -> raises the rate limit on the
                                        # LCM-LoRA download sdgen.py pulls every run

# --- Video niche (aibeautyvideo) ---
# HF_TOKEN above already covers this: attributes Wan 2.2 I2V rCM Space calls on HF
# ZeroGPU to your account instead of hitting anonymous throttling. Nothing else new
# to set -- the video niche reuses the aibeauty photo cron's images and reuses the
# same TikTok token (tiktok_token_niche: "aibeauty" in niches.json).
